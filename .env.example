# Copy to .env and replace every change-me value before starting the stack.
# .env is gitignored. Do not commit real passwords.

# Grafana (bound to 127.0.0.1:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ClickHouse (HTTP 127.0.0.1:8123, native 127.0.0.1:9000)
CLICKHOUSE_USER=honeytrap
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DB=honeytrap
CLICKHOUSE_URL=http://127.0.0.1:8123

# Honeypot
SSH_PORT=2222
HONEYPOT_ID=ssh-01
RUST_LOG=info

# Optional: HoneyTrap -> SentinelForge IOC push (tools/honeytrap_integration.py)
# SENTINELFORGE_API_URL=http://127.0.0.1:8080/api/v1
# SENTINELFORGE_API_KEY=change-me
